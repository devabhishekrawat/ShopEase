```text
ShopEase/
│
├── index.html
├── README.md
│
├── css/
│   └── main.css
│
├── js/
│   ├── main.js
│   └── modules/
│       ├── navbar.js
│       ├── products.js
│       ├── testimonials.js
│       ├── contact.js
│       └── theme.js
│
├── component/
│   ├── navbar.html
│   └── theme-toggle.html
│
├── data/
│   └── testimonials-data.js
│
├── pages/
│   ├- products.html
│   |─ contact.html
│
├── assets/
│   ├── images/
│   ├── hero-product.jpg
│   ├── logo.png
│   └── navbar.png
│
└── favicon.ico
```

